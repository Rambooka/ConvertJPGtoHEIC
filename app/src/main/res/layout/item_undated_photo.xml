<?xml version="1.0" encoding="utf-8"?>
<!-- One photo the repair could find no date for: a thumbnail, what and where it is, and the two
     actions — look at it, or give it a date by hand. Populated in MainActivity.showUndated. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/undatedThumb"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="?attr/colorSurfaceVariant"
        android:contentDescription="@string/undated_thumb_description"
        android:scaleType="centerCrop" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/undatedName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textStyle="bold"
            tools:text="scan 71.heic" />

        <TextView
            android:id="@+id/undatedDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodySmall"
            tools:text="DCIM/Richards wedding · 132 kB" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/undatedViewButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/action_view" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/undatedSetDateButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/action_set_date" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
