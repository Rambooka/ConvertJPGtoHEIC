<?xml version="1.0" encoding="utf-8"?>
<!-- One failed photo in the completion report: what it was, why it failed, and the two actions
     the user can take on it. Populated in MainActivity.showFailures. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="vertical">

    <TextView
        android:id="@+id/failedName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textStyle="bold"
        tools:text="IMG_20240517_142233.jpg" />

    <TextView
        android:id="@+id/failedDetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodySmall"
        tools:text="3.2 MB · too large to decode (out of memory)" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/failedViewButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_view" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/failedDeleteButton"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/action_delete"
            app:iconTint="?attr/colorError"
            android:textColor="?attr/colorError" />
    </LinearLayout>
</LinearLayout>
