<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background. Full bleed: the launcher masks this to whatever shape the device
  uses, so it must cover the whole 108dp square with no detail that matters near the edges.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108">
                <item android:offset="0" android:color="#FF2F6BFF" />
                <item android:offset="1" android:color="#FF7C3AED" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Soft highlight behind the glyph, to lift it off the flat gradient. -->
    <path android:pathData="M54,54m-52,0a52,52 0 1,0 104,0a52,52 0 1,0 -104,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="38"
                android:centerY="34"
                android:gradientRadius="62">
                <item android:offset="0" android:color="#33FFFFFF" />
                <item android:offset="1" android:color="#00FFFFFF" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
